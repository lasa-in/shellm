# Copy this file to .env and fill in the key for your chosen provider.
# shellm uses LiteLLM — only the key for the model you use is required.

# OpenAI (default model: gpt-4o)
OPENAI_API_KEY=sk-...

# Anthropic (use --model claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (use --model gemini/gemini-1.5-pro)
GEMINI_API_KEY=...

# Ollama runs locally — no key needed (use --model ollama/llama3)
# Make sure Ollama is running: https://ollama.ai

# Override the default model
# SHELLM_MODEL=gpt-4o
